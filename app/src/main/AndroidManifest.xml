<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Cada permiso se pide en el momento de usarlo, después de una pantalla que explica para qué. -->
    <!-- Nombres y números desde la agenda del sistema: T9, favoritos y a quién pertenece un número. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Recientes y "el chip con el que llamé la última vez". -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Borrar entradas de recientes. -->
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <!-- Listar los chips activos y las cuentas de llamada. Sin él, decide el sistema. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Llamar con el chip elegido. Sin él se abre el marcador del sistema (ACTION_DIAL). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Notificaciones de llamada entrante, en curso y perdida. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Mostrar la llamada entrante sobre la pantalla de bloqueo. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Sensor de proximidad: apagar la pantalla con el celu en la oreja. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        Prohibidos aunque una librería los pida: la app no usa la red ni la ubicación. El estado de
        servicio de los chips se lee sin ubicación (TelephonyCallback.ServiceStateListener).
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" tools:node="remove" />

    <!--
        El marcador se usa si el celu lo tiene, pero la app solo depende de que exista telefonía
        para llamar; en una tablet sigue abriendo.
    -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!--
        Fuera lo que agregan las librerías y la app no usa, para que el manifest final solo tenga
        componentes propios:
        - el permiso interno de androidx.core para receptores dinámicos (no se usa ContextCompat);
        - androidx.startup, que arrancaría emoji2 (puede pedir fuentes a Google Play Services),
          lifecycle-process y profileinstaller;
        - el receptor de profileinstaller (herramientas de desarrollo).
    -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!-- Sin backup ni transferencia de datos a otro dispositivo (ver data_extraction_rules). -->
    <application
        android:name=".PhoneApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiquidPhone">

        <!--
            DIAL con y sin número es lo que exige el sistema para poder elegir la app como marcador.
            Otra app solo puede dejar un número escrito en el teclado: acá no hay ACTION_CALL.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- Pantalla de llamada, también sobre la de bloqueo. La abren el servicio y las notificaciones. -->
        <activity
            android:name=".incall.InCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity="${applicationId}.incall"
            android:turnScreenOn="true" />

        <!--
            Solo Telecom puede conectarse. Sin IN_CALL_SERVICE_RINGING: el tono lo pone el sistema.
        -->
        <service
            android:name=".incall.PhoneInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".incall.CallActionReceiver"
            android:exported="false" />
        <!-- Exportado porque lo manda Telecom. No usa nada del intent: todo sale del registro. -->
        <receiver
            android:name=".incall.MissedCallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <!-- Un alias por ícono de la app: solo uno está activo (ver util/AppIcons.kt). -->
        <activity-alias
            android:name=".IconLiquid"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconMaterial"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_material"
            android:roundIcon="@mipmap/ic_launcher_material"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconSamsung"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_samsung"
            android:roundIcon="@mipmap/ic_launcher_samsung"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconIphone"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_iphone"
            android:roundIcon="@mipmap/ic_launcher_iphone"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconMotorola"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
