<!--
    Solo debug y profile. WRITE_CONTACTS es para crear y borrar los contactos de prueba: la app en sí
    nunca escribe en la agenda. El receptor atiende a la herramienta de pruebas desde adb; está
    protegido con DUMP, que tiene el shell de adb y ninguna app instalada por el usuario.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <application>
        <!-- Vista previa de la llamada entrante, sin llamada. Protegida igual que el receptor. -->
        <activity
            android:name=".DevIncomingActivity"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver
            android:name=".DevReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.liquidphone.DEV_STATUS" />
                <action android:name="dev.liquidphone.DEV_GENERATE" />
                <action android:name="dev.liquidphone.DEV_CLEAR" />
                <action android:name="dev.liquidphone.DEV_STYLE" />
                <action android:name="dev.liquidphone.DEV_RING" />
                <action android:name="dev.liquidphone.DEV_RING_END" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
